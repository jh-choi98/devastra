{
  "name": "devastra",
  "version": "0.1.0",
  "private": true,
  "description": "A developer skill constellation that lights up as you code.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:local": "PLAYWRIGHT_USE_MOCK_OAUTH=1 ALLOW_MOCK_OAUTH=1 playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "email:dev": "email dev --dir lib/email/templates",
    "inngest:dev": "npx inngest-cli@latest dev",
    "size": "size-limit --config .size-limit.cjs",
    "visual:test": "playwright test tests/visual",
    "axe:test": "playwright test tests/a11y"
  },
  "dependencies": {
    "@react-email/components": "^0",
    "@react-three/drei": "^9.108",
    "@react-three/fiber": "^8.16",
    "@react-three/postprocessing": "^2.16",
    "@sentry/nextjs": "^8",
    "@supabase/ssr": "^0",
    "@supabase/supabase-js": "^2",
    "@vercel/og": "^0",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2",
    "drizzle-orm": "^0",
    "framer-motion": "^11",
    "inngest": "^3",
    "jose": "^6.2.3",
    "next": "^14",
    "postgres": "^3",
    "posthog-js": "^1",
    "posthog-node": "^4",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^4",
    "server-only": "^0",
    "simplex-noise": "^4",
    "sonner": "^1",
    "svix": "^1.93.0",
    "tailwind-merge": "^2",
    "three": "^0.165",
    "zod": "^3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10",
    "@playwright/test": "^1",
    "@size-limit/preset-app": "^11",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^2",
    "autoprefixer": "^10",
    "drizzle-kit": "^0",
    "eslint": "^8",
    "eslint-config-next": "^14",
    "postcss": "^8",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0",
    "react-email": "^3",
    "sharp": "^0.34.5",
    "size-limit": "^11",
    "tailwindcss": "^3",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^2"
  }
}

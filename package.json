{
  "name": "devatlas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:local": "PLAYWRIGHT_USE_MOCK_OAUTH=1 ALLOW_MOCK_OAUTH=1 playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "email:dev": "email dev --dir lib/email/templates",
    "inngest:dev": "npx inngest-cli@latest dev"
  },
  "dependencies": {
    "next": "^14",
    "react": "^18",
    "react-dom": "^18",
    "@supabase/supabase-js": "^2",
    "@supabase/ssr": "^0",
    "drizzle-orm": "^0",
    "postgres": "^3",
    "inngest": "^3",
    "resend": "^4",
    "@react-email/components": "^0",
    "@vercel/og": "^0",
    "framer-motion": "^11",
    "simplex-noise": "^4",
    "zod": "^3",
    "posthog-js": "^1",
    "posthog-node": "^4",
    "@sentry/nextjs": "^8",
    "sonner": "^1",
    "server-only": "^0",
    "clsx": "^2",
    "tailwind-merge": "^2"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "tailwindcss": "^3",
    "postcss": "^8",
    "autoprefixer": "^10",
    "drizzle-kit": "^0",
    "vitest": "^2",
    "@vitest/coverage-v8": "^2",
    "@playwright/test": "^1",
    "eslint": "^8",
    "eslint-config-next": "^14",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0",
    "tsx": "^4",
    "react-email": "^3"
  }
}
